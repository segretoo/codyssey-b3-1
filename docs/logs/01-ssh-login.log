# 일시: 2026-10-05 / 리전: ap-tokyo-1 / 인스턴스: b31-web-01 (Ubuntu 22.04)
# 접속 대상: Reserved Public IP 168.110.46.76 (b31-eip)
# 참고: 첫 시도는 <새 퍼블릭 IP> 자리표시자를 그대로 입력해 중단(^C)했고, 실제 IP로 다시 접속함

segreto@DESKTOP-J7HKRCG MINGW64 ~/Desktop/Codyssey/codyssey-b3-1 (main)
$ mkdir -p ~/.ssh && mv ~/Downloads/ssh-key-*.key ~/.ssh/

segreto@DESKTOP-J7HKRCG MINGW64 ~/Desktop/Codyssey/codyssey-b3-1 (main)
$ chmod 400 ~/.ssh/ssh-key-*.key

segreto@DESKTOP-J7HKRCG MINGW64 ~/Desktop/Codyssey/codyssey-b3-1 (main)
$ ssh -i ~/.ssh/ssh-key-*.key ubuntu@<새 퍼블릭 IP>^C

